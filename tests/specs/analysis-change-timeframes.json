[
  {
    "name": "Re-run with different timeframes",
    "steps": [
      {
        "expect": [
          {
              "method": "editMessageText",
            "payload": {
              "text": "Choose a supported top-down timeframe set."
            }
          }
        ],
        "send": {
          "callback": "analysis:change_timeframes"
        }
      }
    ]
  },
  {
    "name": "A timeframe can be selected before a chart is sent",
    "steps": [
      {
        "send": { "callback": "analysis:frames:intraday" },
        "expect": [{ "method": "editMessageText", "payload": { "text": "Timeframes saved. Send an MT5 chart with entry and stop levels to run the analysis." } }]
      }
    ]
  }
]
